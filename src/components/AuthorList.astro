---
import { normalizeAuthors, type AuthorItem } from '@utils/author'

interface Props {
  author?: any
  authors?: any
  class?: string
}

const {
  author,
  authors,
  class: className = '',
} = Astro.props as Props

const authorList: AuthorItem[] = normalizeAuthors(author, authors)
---

{authorList.length > 0 ? (
  <div class={`author-list-container inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-slate-700 dark:text-slate-300 ${className}`}>
    {authorList.map((a, index) => {
      const isLast = index === authorList.length - 1
      return (
        <span class="inline-flex items-center group relative whitespace-nowrap">
          <span class="font-medium text-slate-900 dark:text-slate-100 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
            {a.name}
          </span>

          {/* 学术规范标注角标（hover悬浮提示，不显示文本注脚） */}
          {a.equalContribution && (
            <sup class="ml-0.5 font-semibold text-xs tracking-tighter text-sky-600 dark:text-sky-400 select-none cursor-help" title="同等贡献 (Equal contribution)">
              †
            </sup>
          )}
          {a.corresponding && (
            <sup class="ml-0.5 font-semibold text-xs tracking-tighter text-sky-600 dark:text-sky-400 select-none cursor-help" title={`通讯作者 (Corresponding author)${a.email ? `: ${a.email}` : ''}`}>
              ✉
            </sup>
          )}

          {/* 职责标签 (如: 文稿/排版/审核) */}
          {a.role && (
            <span class="ml-1 px-1.5 py-0.2 text-[11px] font-normal tracking-wide rounded bg-slate-100 dark:bg-white/10 text-slate-500 dark:text-slate-400 border border-slate-200/60 dark:border-white/10">
              {a.role}
            </span>
          )}

          {/* 分隔逗号 */}
          {!isLast && <span class="text-slate-400 dark:text-slate-500 mr-0.5">,</span>}
        </span>
      )
    })}
  </div>
) : null}
