---
interface Props {
  title?: string;
  description?: string;
  hideHeaderFooter?: boolean;
  disableWaveBg?: boolean;
}
import { ViewTransitions } from "astro:transitions";
import WaveBackground from "@components/WaveBackground.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import "@styles/global.css";
import { withBase } from "@utils/path";
import { getI18n } from "@utils/i18n";

const {
  title: rawTitle,
  description: rawDesc,
  hideHeaderFooter = false,
  disableWaveBg = false,
} = Astro.props as Props;

const { currentLocale, isEn, localePrefix, pathNoLocale, isHomeNormalized, t } = getI18n(Astro.url);
const title = rawTitle ? (rawTitle === "四川大学科幻协会" ? t('site.orgName', '四川大学科幻协会') : rawTitle) : t('site.orgName', '四川大学科幻协会');
const description = rawDesc ? (rawDesc === "社团官网与文章活动归档" ? t('site.description', '社团官网与消息门户') : rawDesc) : t('site.description', '社团官网与消息门户');
---

<!doctype html>
<html lang={isEn ? "en" : "zh-CN"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {isHomeNormalized ? (
      <meta name="robots" content="index, follow" />
    ) : (
      <meta name="robots" content="noindex, nofollow, noarchive" />
    )}
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      (function() {
        function applyTheme(targetDoc) {
          try {
            var doc = targetDoc || document.documentElement;
            var stored = localStorage.getItem('theme');
            var preferDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (stored === 'dark' || (!stored && preferDark)) {
              doc.classList.add('dark');
            } else {
              doc.classList.remove('dark');
            }
          } catch (e) {}
        }
        applyTheme(document.documentElement);
        document.addEventListener('astro:before-swap', function(e) {
          try {
            var newLang = e.newDocument.documentElement.getAttribute('lang');
            if (newLang) {
              document.documentElement.setAttribute('lang', newLang);
            }
          } catch (_) {}
          applyTheme(e.newDocument.documentElement);
        });
        document.addEventListener('astro:after-swap', function() {
          applyTheme(document.documentElement);
        });
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <link rel="mask-icon" href={withBase('/favicon.svg')} color="#0ea5e9" />
  </head>
  <body
    class={`min-h-screen bg-[#f5f5f7] text-[#1d1d1f] dark:bg-[#161617] dark:text-[#f2f2f7] relative ${hideHeaderFooter ? "hide-header-footer" : ""}`}
  >
    {!disableWaveBg && <WaveBackground />}
    <div class="relative z-10 flex flex-col min-h-screen w-full">
      <SiteHeader localePrefix={localePrefix} currentLocale={currentLocale} isHomeNormalized={isHomeNormalized} pathNoLocale={pathNoLocale} t={t} />
      <main class="flex-1 w-full mx-auto max-w-6xl px-4 py-8 relative">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
