---
import BaseLayout from '@layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import PostCard from '@components/PostCard.astro'
import SectionHeader from '@components/SectionHeader.astro'
import { getI18n } from '@utils/i18n'
import '@styles/articles.css'

const { t, localePrefix } = getI18n(Astro.url)

const SECTION_META = [
  {
    slugPrefix: 'contributions',
    title: t('articles.contributions', '征文'),
    link: `${localePrefix}/articles/contributions/`,
    linkLabel: t('site.viewAll', '更多'),
  },
  {
    slugPrefix: 'essays',
    title: t('articles.essays', '随笔'),
    link: `${localePrefix}/articles/essays/`,
    linkLabel: t('site.viewAll', '更多'),
  },
  {
    slugPrefix: 'reviews',
    title: t('articles.reviews', '评论'),
    link: `${localePrefix}/articles/reviews/`,
    linkLabel: t('site.viewAll', '更多'),
  },
  {
    slugPrefix: 'classics',
    title: t('articles.classics', '名篇'),
    link: `${localePrefix}/articles/classics/`,
    linkLabel: t('site.viewAll', '更多'),
  },
] as const

const articles = await getCollection('articles')
  .then((xs) => xs
    .filter((item) => !item.slug.includes('article-template') && !item.slug.includes(' copy'))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)))

type SectionSlug = (typeof SECTION_META)[number]['slugPrefix']
const grouped = new Map<SectionSlug, typeof articles>()
SECTION_META.forEach(({ slugPrefix }) => grouped.set(slugPrefix, []))

articles.forEach((item) => {
  const [rawPrefix] = item.slug.split('/')
  const isKnown = SECTION_META.some(({ slugPrefix }) => slugPrefix === rawPrefix)
  const key: SectionSlug = isKnown ? (rawPrefix as SectionSlug) : 'essays'
  const list = grouped.get(key)
  if (list) {
    list.push(item)
  }
})
---
<BaseLayout title="文章 - SFA">
  <section class="space-y-12">

    {SECTION_META.map(({ slugPrefix, title, link, linkLabel }) => {
      const list = grouped.get(slugPrefix) ?? []
      return (
        <section class="space-y-4" data-section={slugPrefix}>
          <SectionHeader title={title} link={link} linkLabel={linkLabel} />
          {list.length ? (
            <div class="horizontal-scroll overflow-x-auto -mx-4 px-4">
              <div class="articles-row flex gap-4 pt-3 pb-4 snap-x snap-mandatory">
                {list.slice(0, 6).map((a, i) => (
                  <div class="min-w-[18rem] max-w-xs flex-shrink-0 snap-start post-card-anim" data-idx={i}>
                    <PostCard href={`/articles/${a.slug}/`} title={a.data.title} date={a.data.date} cover={a.data.cover} tags={a.data.tags} summary={a.data.summary} />
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <p class="text-xs text-slate-400">暂时还没有内容，欢迎稍后查看。</p>
          )}
        </section>
      )
    })}
  </section>

  

  <script>
    let io: IntersectionObserver | null = null;

    document.addEventListener('astro:page-load', () => {
      const cards = Array.from(document.querySelectorAll('.post-card-anim'));
      if (!cards.length) return;

      if (!('IntersectionObserver' in window)) {
        cards.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      io?.disconnect();
      io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io?.unobserve(e.target);
          }
        }
      }, { threshold: 0.2 });

      cards.forEach((el) => io?.observe(el));
    });

    document.addEventListener('astro:before-swap', () => {
      io?.disconnect();
      io = null;
    });
  </script>
</BaseLayout>
